---
interface Props {
  id: number;
  title: string;
  content: string;
  username: string;
  createdAt: string;
  excerpt?: boolean;
}

const { id, title, content, username, createdAt, excerpt = true } = Astro.props;
const displayContent = excerpt ? content.substring(0, 200) + '...' : content;
const formattedDate = new Date(createdAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="card p-6">
  <div class="flex items-start gap-4">
    <div class="flex-shrink-0">
      <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
        {username.charAt(0).toUpperCase()}
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <h2 class="text-xl font-bold mb-1">
        <a href={`/post/${id}`} class="text-gray-900 hover:text-blue-600">
          {title}
        </a>
      </h2>
      <div class="text-sm text-gray-500 mb-3">
        <span class="font-semibold">{username}</span>
        <span class="mx-1">•</span>
        <span>{formattedDate}</span>
      </div>
      <p class="text-gray-700 mb-3 line-clamp-3">{displayContent}</p>
      <a href={`/post/${id}`} class="text-blue-600 hover:text-blue-800 font-semibold text-sm">
        Read more →
      </a>
    </div>
  </div>
</article>