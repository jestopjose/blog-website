---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCurrentUser } from '../lib/auth';

const user = getCurrentUser(Astro.cookies);
if (user) {
  return Astro.redirect('/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<Layout title="Login - BlogSite">
  <div class="flex flex-col min-h-screen">
    <Header />
    
    <main class="flex-grow flex items-center justify-center px-4 py-12">
      <div class="max-w-md w-full card p-8">
        <h1 class="text-3xl font-bold text-center mb-6 text-gray-900">Login</h1>
        
        {error && (
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4">
            {error === 'invalid' && 'Invalid email or password'}
          </div>
        )}
        
        <form action="/api/auth/login" method="POST" class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
            />
          </div>
          
          <div>
            <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
              Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
            />
          </div>
          
          <button type="submit" class="w-full btn btn-primary">
            Login
          </button>
        </form>
        
        <p class="mt-4 text-center text-gray-600">
          Don't have an account?
          <a href="/signup" class="text-blue-600 hover:text-blue-800 font-semibold ml-1">
            Sign Up
          </a>
        </p>
      </div>
    </main>
    
    <Footer />
  </div>
</Layout>