---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CommentForm from '../../components/CommentForm.astro';
import CommentList from '../../components/CommentList.astro';
import { getCurrentUser } from '../../lib/auth';
import db from '../../lib/db';

const { id } = Astro.params;

const post = db.prepare(`
  SELECT p.*, u.username
  FROM posts p
  JOIN users u ON p.user_id = u.id
  WHERE p.id = ?
`).get(id);

if (!post) {
  return Astro.redirect('/');
}

const user = getCurrentUser(Astro.cookies);
const formattedDate = new Date(post.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={`${post.title} - BlogSite`}>
  <div class="flex flex-col min-h-screen">
    <Header />
    
    <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <article class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{post.title}</h1>
        <div class="text-gray-600 mb-6">
          By <span class="font-semibold">{post.username}</span> on {formattedDate}
        </div>
        <div class="prose max-w-none">
          <p class="text-gray-700 whitespace-pre-wrap">{post.content}</p>
        </div>
      </article>
      
      <div class="bg-white rounded-lg shadow-md p-8">
        <CommentList postId={Number(id)} />
        
        {user ? (
          <CommentForm postId={Number(id)} />
        ) : (
          <div class="mt-8 text-center py-4 bg-gray-50 rounded-lg">
            <p class="text-gray-600">
              Please <a href="/login" class="text-blue-600 hover:text-blue-800 font-semibold">login</a> to comment
            </p>
          </div>
        )}
      </div>
    </main>
    
    <Footer />
  </div>
</Layout>